{
  "manifest_version": 3,
  "name": "AI QA Assistant",
  "version": "1.0",
  "description": "Автоматизация тестов на базе эмбеддингов (RU)",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Открыть панель тестировщика"
  },
  "background": {
  "service_worker": "background.js",
  "type": "module"
},
"content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}
}
